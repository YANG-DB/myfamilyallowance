---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import { getAccessibleKid } from '../../../../../lib/auth';
import { avatars } from '../../../../../lib/avatars';
const {slug,id}=Astro.params;
const kid=slug && id ? await getAccessibleKid(Astro.cookies,slug,id) : null;
if (!kid) return Astro.redirect('/kid-login');
const back=`/f/${slug}/kid/${kid.id}`;
const error=Astro.url.searchParams.get('error');
---
<BaseLayout title={`Choose ${kid.name}’s character · My Family Allowance`}>
  <Fragment slot="nav"><a class="btn btn-ghost btn-small" href={back}>Back to my account</a></Fragment>
  <section class="character-picker">
    <p class="eyebrow">MAKE IT YOURS, {kid.name.toUpperCase()}</p>
    <h1>Who’s your character?</h1>
    <p class="picker-intro">Pick a face for your money adventures. You can change it whenever you like.</p>
    {error && <p class="flash flash-err" role="alert">{error}</p>}
    <form method="POST" action={`/api/family/${slug}/kid/${kid.id}/avatar`}>
      <fieldset>
        <legend class="sr-only">Choose your avatar character</legend>
        <div class="character-grid">
          {avatars.map(avatar => (
            <label class="character-option">
              <input type="radio" name="avatarId" value={avatar.id} checked={kid.avatarId===avatar.id} required />
              <span class="character-tile" style={`--character-color:${avatar.color}`}>
                <span class="character-face" aria-hidden="true">{avatar.character}</span>
                <span class="selected-mark" aria-hidden="true">✓</span>
              </span>
              <span class="character-name">{avatar.name}</span>
              <span class="selected-label" aria-hidden="true">Selected</span>
            </label>
          ))}
        </div>
      </fieldset>
      <div class="picker-actions">
        <button class="btn btn-primary" type="submit">Save my character</button>
        <a class="btn btn-ghost" href={back}>Cancel</a>
      </div>
    </form>
  </section>
</BaseLayout>
<style>
  .character-picker {max-width:760px;margin:2.5rem auto 4rem;text-align:center;}
  .eyebrow {color:var(--leaf-deep);font-size:.75rem;font-weight:800;letter-spacing:.14em;}
  h1 {font-size:clamp(2rem,5vw,3.1rem);margin:.5rem 0;}
  .picker-intro {max-width:440px;margin:.5rem auto 2rem;color:var(--muted);}
  fieldset {padding:0;border:0;margin:0;min-width:0;}
  .character-grid {display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1.4rem 1.1rem;}
  .character-option {display:flex;flex-direction:column;position:relative;cursor:pointer;align-items:center;min-width:0;}
  .character-option input {position:absolute;width:1px;height:1px;opacity:0;}
  .character-tile {position:relative;display:flex;align-items:center;justify-content:center;width:100%;aspect-ratio:1;border:4px solid transparent;border-radius:22px;background:var(--character-color);transition:transform .15s,border-color .15s,box-shadow .15s;}
  .character-face {font-size:clamp(2.5rem,8vw,5rem);line-height:1;}
  .character-name {margin-top:.6rem;font-weight:800;font-size:.9rem;}
  .selected-mark {display:none;position:absolute;right:6px;bottom:6px;width:26px;height:26px;border-radius:50%;background:var(--leaf-deep);color:white;font-weight:800;align-items:center;justify-content:center;}
  .selected-label {visibility:hidden;font-size:.75rem;color:var(--leaf-deep);font-weight:800;}
  input:checked + .character-tile {border-color:var(--leaf-deep);box-shadow:0 0 0 4px #2f7d571c;}
  input:checked + .character-tile .selected-mark {display:flex;}
  input:checked ~ .selected-label {visibility:visible;}
  input:focus-visible + .character-tile {outline:3px solid var(--ink);outline-offset:5px;}
  .character-option:hover .character-tile {transform:translateY(-4px);}
  .picker-actions {display:flex;gap:.75rem;justify-content:center;flex-wrap:wrap;margin-top:2rem;}
  .sr-only {position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;}
  @media(max-width:540px) {.character-grid {grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem .75rem;}.character-name {font-size:.8rem;}.character-tile {border-radius:16px;}.character-picker {margin-top:1.5rem;}}
  @media(prefers-reduced-motion:reduce) {.character-tile {transition:none;}.character-option:hover .character-tile {transform:none;}}
</style>
