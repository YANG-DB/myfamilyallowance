---
import KidAvatar from '../../../components/KidAvatar.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { requireFamilyAccess, getSessionKid, siteUrl } from '../../../lib/auth';
import { getFamilyBySlug, getKidsWithBalances } from '../../../lib/data';
import { formatMoney } from '../../../lib/money';

const slug = Astro.params.slug;
if (!slug || !/^[a-z0-9]{5}$/.test(slug)) {
  return Astro.redirect('/');
}

const owner = await requireFamilyAccess(Astro.cookies, slug);
if (!owner) {
  const kid = await getSessionKid(Astro.cookies);
  if (kid) {
    const parent = await getFamilyBySlug(slug);
    if (parent?.id === kid.userId) return Astro.redirect(`/f/${slug}/kid/${kid.id}`);
  }
  return Astro.redirect('/kid-login');
}
const error = Astro.url.searchParams.get('error');

let kids: Awaited<ReturnType<typeof getKidsWithBalances>> = [];
if (owner) {
  kids = await getKidsWithBalances(owner.id);
}

const familyUrl = `${siteUrl()}/f/${slug}`;
---

<BaseLayout title="Family totals · My Family Allowance">
  <Fragment slot="nav">
    {owner && (
      <form method="POST" action={`/api/family/${slug}/logout`}>
        <button class="btn btn-ghost btn-small" type="submit" aria-label="Lock" title="Logout">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </button>
      </form>
    )}
  </Fragment>

  <section style="padding: 1rem 0 2.5rem">
    <h1>Family totals</h1>
    <p class="meta">{familyUrl}</p>

    {error && <div class="flash flash-err">{error}</div>}

    {kids.length === 0 ? (
      <div class="panel">
        <p class="muted">No kids have been added yet.</p>
      </div>
    ) : (
      <div class="kid-list">
        {kids.map((kid) => (
          <a class="kid-card" href={`/f/${slug}/kid/${kid.id}`} style="text-decoration:none;color:inherit">
            <div>
              <div style="display:flex;align-items:center;gap:.8rem;margin-bottom:.6rem"><KidAvatar id={kid.avatarId} /><h3 style="margin:0">{kid.name}</h3></div>
              <p class="meta">Monthly allowance {formatMoney(kid.monthlyAllowanceCents)}</p>
            </div>
            <div class:list={['balance', { neg: kid.balanceCents < 0 }]}>
              {formatMoney(kid.balanceCents)}
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
