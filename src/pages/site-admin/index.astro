---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { requireSiteAdmin } from '../../lib/auth';
import { getSiteStats } from '../../lib/data';

const isAdmin = await requireSiteAdmin(Astro.cookies);
const error = Astro.url.searchParams.get('error');
const stats = isAdmin ? await getSiteStats() : null;
---

<BaseLayout title="Site Admin · My Family Allowance">
  <Fragment slot="nav">
    <a class="btn btn-ghost btn-small" href="/">Home</a>
    {isAdmin && (
      <form method="POST" action="/api/site-admin/logout" style="display:inline">
        <button class="btn btn-ghost btn-small" type="submit">Log out</button>
      </form>
    )}
  </Fragment>

  <section style="padding: 1rem 0 2.5rem">
    <h1>Site admin</h1>

    {error && <div class="flash flash-err">{error}</div>}

    {!isAdmin ? (
      <div class="panel" style="max-width:420px">
        <h2>Sign in</h2>
        <p>Enter the site admin password to continue.</p>
        <form class="form-grid" method="POST" action="/api/site-admin/login">
          <label for="site-admin-password">
            Password
            <input
              id="site-admin-password"
              type="password"
              name="password"
              required
              autocomplete="current-password"
              enterkeyhint="done"
              autofocus
            />
          </label>
          <button class="btn btn-primary" type="submit">Sign in</button>
        </form>
      </div>
    ) : (
      stats && (
        <div class="stack" style="gap: 1.25rem">
          <div class="stat-grid">
            <article class="stat-card">
              <div class="stat-label">Users (Families)</div>
              <div class="stat-value">{stats.users.toLocaleString()}</div>
            </article>
            <article class="stat-card">
              <div class="stat-label">Kids</div>
              <div class="stat-value">{stats.kids.toLocaleString()}</div>
            </article>
            <article class="stat-card">
              <div class="stat-label">Transactions</div>
              <div class="stat-value">{stats.transactions.toLocaleString()}</div>
            </article>
          </div>

          <div class="stat-grid">
            <article class="stat-card">
              <div class="stat-label">Logins (Past 24h)</div>
              <div class="stat-value">{stats.loginsLast24Hours.toLocaleString()}</div>
            </article>
            <article class="stat-card">
              <div class="stat-label">Logins (Past 7d)</div>
              <div class="stat-value">{stats.loginsLast7Days.toLocaleString()}</div>
            </article>
            <article class="stat-card">
              <div class="stat-label">Logins (Past 30d)</div>
              <div class="stat-value">{stats.loginsLast30Days.toLocaleString()}</div>
            </article>
          </div>

          <div class="panel">
            <h2 id="recent-logins-heading">Last 10 logins</h2>
            {stats.recentLogins.length === 0 ? (
              <p class="muted">No logins recorded yet.</p>
            ) : (
              <div
                class="table-wrap"
                tabindex="0"
                role="region"
                aria-labelledby="recent-logins-heading"
              >
                <table>
                  <thead>
                    <tr>
                      <th scope="col">Name</th>
                      <th scope="col">Email</th>
                      <th scope="col">Last login</th>
                    </tr>
                  </thead>
                  <tbody>
                    {stats.recentLogins.map((u) => (
                      <tr>
                        <th scope="row">{u.name}</th>
                        <td>{u.email}</td>
                        <td>
                          {u.lastLogIn
                            ? u.lastLogIn.toLocaleString('en-US', {
                                timeZone: 'America/Chicago',
                                dateStyle: 'medium',
                                timeStyle: 'short',
                              })
                            : '—'}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </div>
        </div>
      )
    )}
  </section>
</BaseLayout>
