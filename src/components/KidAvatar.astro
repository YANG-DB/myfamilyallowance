---
import { getAvatar } from '../lib/avatars';
interface Props { id?: string | null; size?: 'small' | 'large'; }
const {id, size='small'}=Astro.props;
const avatar=getAvatar(id);
---
<span class:list={['kid-avatar',{'kid-avatar-large':size==='large'}]} style={`--avatar-color:${avatar.color}`} role="img" aria-label={avatar.name}>{avatar.character}</span>
<style>
  .kid-avatar {display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;width:64px;height:64px;border-radius:18px;background:var(--avatar-color);font-size:2.5rem;line-height:1;box-shadow:inset 0 0 0 1px #00000008;}
  .kid-avatar-large {width:108px;height:108px;border-radius:26px;font-size:4.4rem;}
</style>
