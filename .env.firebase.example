# Copy to .firebase-app/.env.<your-firebase-project-id> after firebase:prepare.
# Keys starting with FIREBASE_, X_GOOGLE_, or EXT_ are reserved and rejected by Cloud
# Functions — the project id is read from the runtime-provided GCLOUD_PROJECT instead.
SITE_URL=https://<your-firebase-project-id>.web.app
OWNER_EMAIL=you@example.com
# Store SESSION_SECRET and INITIAL_SETUP_TOKEN in Firebase Secret Manager.
# Google/Firebase Authentication is not required; account passwords are verified server-side.
